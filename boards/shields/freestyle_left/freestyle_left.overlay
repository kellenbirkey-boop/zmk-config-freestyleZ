#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;

        /*
         * Pins taken directly from Freestyle_L.kicad_pcb (net names P1, P2, ...
         * match the &pro_micro numbers).
         *
         * Columns (switch pin 1):  pinky P7, ring P18, middle P19, index P20,
         *                          inner P21, thumbs P15 / P14 / P16
         * Rows (diode pad 1):      bottom P2, home P3, top P4, upper P5,
         *                          thumb row P1
         *
         * row2col: use this when the diode stripes (cathodes) face the
         * switch/column side. For stripes on the row side, use col2row with
         * the pull-downs on the rows instead.
         */
        col-gpios =
            <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 0: pinky  */
            <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 1: ring   */
            <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 2: middle */
            <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 3: index  */
            <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 4: inner  */
            <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 5: thumb 1 (left)   */
            <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,   /* col 6: thumb 2 (middle) */
            <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;   /* col 7: thumb 3 (right)  */

        row-gpios =
            <&pro_micro 2 GPIO_ACTIVE_HIGH>,   /* row 0: bottom */
            <&pro_micro 3 GPIO_ACTIVE_HIGH>,   /* row 1: home   */
            <&pro_micro 4 GPIO_ACTIVE_HIGH>,   /* row 2: top    */
            <&pro_micro 5 GPIO_ACTIVE_HIGH>,   /* row 3: upper  */
            <&pro_micro 1 GPIO_ACTIVE_HIGH>;   /* row 4: thumbs */
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <5>;

        /* Reads top row to bottom row, left to right, then the 3 thumb keys */
        map = <
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(4,5) RC(4,6) RC(4,7)
        >;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };
};
